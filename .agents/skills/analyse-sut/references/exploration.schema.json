{
  "title": "SUT exploration artifact (analyse-sut output)",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "meta": {
      "type": "object",
      "properties": {
        "ticket": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9]+-\\d+$"
        },
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "baseURL": {
          "type": "string",
          "format": "uri"
        },
        "apiURL": {
          "type": "string",
          "format": "uri"
        },
        "authFile": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "ticket",
        "date",
        "baseURL",
        "apiURL",
        "authFile"
      ],
      "additionalProperties": false
    },
    "locators": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "tcRef": {
            "type": "string",
            "pattern": "^TC-\\d+$"
          },
          "tcAction": {
            "type": "string",
            "minLength": 1,
            "description": "Business wording from the test case step"
          },
          "uiLabel": {
            "type": "string",
            "minLength": 1,
            "description": "Text actually rendered in the UI"
          },
          "locator": {
            "type": "string",
            "minLength": 1,
            "description": "Playwright expression, e.g. getByRole('button', { name: 'Send' })"
          },
          "page": {
            "type": "string",
            "minLength": 1
          },
          "verifiedBy": {
            "type": "string",
            "enum": [
              "snapshot",
              "click",
              "fill",
              "select",
              "assert"
            ]
          },
          "notes": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "tcRef",
          "tcAction",
          "uiLabel",
          "locator",
          "page",
          "verifiedBy",
          "notes"
        ],
        "additionalProperties": false
      }
    },
    "apiCalls": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "tcRef": {
            "type": "string",
            "pattern": "^TC-\\d+$"
          },
          "trigger": {
            "type": "string",
            "minLength": 1
          },
          "method": {
            "type": "string",
            "enum": [
              "GET",
              "POST",
              "PUT",
              "PATCH",
              "DELETE"
            ]
          },
          "pathPattern": {
            "type": "string",
            "minLength": 1,
            "description": "Path only, no host — e.g. /messages/{id}"
          },
          "auth": {
            "type": "string",
            "enum": [
              "none",
              "bearer"
            ]
          },
          "requestFields": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "responseFields": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "observed": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "case": {
                  "type": "string",
                  "minLength": 1,
                  "description": "What was sent, in words"
                },
                "status": {
                  "type": "integer",
                  "minimum": 100,
                  "maximum": 599
                },
                "body": {
                  "description": "Short note on the response body shape — not a full dump",
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "case",
                "status",
                "body"
              ],
              "additionalProperties": false
            },
            "description": "Live pre-flight results — the contract source of truth"
          }
        },
        "required": [
          "tcRef",
          "trigger",
          "method",
          "pathPattern",
          "auth",
          "requestFields",
          "responseFields",
          "observed"
        ],
        "additionalProperties": false
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "tcRef": {
            "type": "string",
            "pattern": "^TC-\\d+$"
          },
          "step": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "expected": {
            "type": "string",
            "minLength": 1,
            "description": "What the test case says"
          },
          "observed": {
            "type": "string",
            "minLength": 1,
            "description": "What the live SUT did"
          },
          "resolution": {
            "type": "string",
            "enum": [
              "assert-observed",
              "move-to-ui",
              "move-to-api",
              "annotate-gap"
            ]
          }
        },
        "required": [
          "tcRef",
          "step",
          "expected",
          "observed",
          "resolution"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "meta",
    "locators",
    "apiCalls",
    "findings"
  ],
  "additionalProperties": false
}
