{
  "issues": [
    {
      "key": "TC-1",
      "fields": {
        "issuetype": {
          "name": "Test"
        },
        "summary": "Verify that the contact API rejects invalid messages and accepts a boundary-length message",
        "description": "Step 5 follows AC-2. Whether the 50-character minimum is enforced by the service or only by the form is not stated in the story.",
        "priority": {
          "name": "High"
        },
        "components": [
          {
            "name": "api"
          }
        ],
        "labels": [
          "AC-4",
          "AC-5",
          "AC-6",
          "AC-2"
        ],
        "issuelinks": [
          {
            "type": {
              "name": "Test",
              "inward": "is tested by",
              "outward": "tests"
            },
            "outwardIssue": {
              "key": "TOOL-1",
              "fields": {
                "summary": "Contact customer service from the storefront"
              }
            }
          },
          {
            "type": {
              "name": "Precondition",
              "inward": "is a precondition of",
              "outward": "has precondition"
            },
            "inwardIssue": {
              "key": "PRE-1",
              "fields": {
                "summary": "The contact endpoint POST /messages is reachable without authentication"
              }
            }
          }
        ],
        "customfield_10004": {
          "steps": [
            {
              "index": 1,
              "fields": {
                "action": "Send a contact message with a malformed email address",
                "data": "{ \"name\": \"Jane Doe\", \"email\": \"not-an-email\", \"subject\": \"customer-service\", \"message\": \"<valid 60 character message>\" }",
                "expected result": "HTTP 422; the validation error names the email field"
              }
            },
            {
              "index": 2,
              "fields": {
                "action": "Send a contact message without a subject",
                "data": "{ \"name\": \"Jane Doe\", \"email\": \"jane@example.com\", \"message\": \"<valid 60 character message>\" }",
                "expected result": "HTTP 422; the validation error names the subject field"
              }
            },
            {
              "index": 3,
              "fields": {
                "action": "Send a contact message of 251 characters",
                "data": "message: 251 x 'x'",
                "expected result": "HTTP 422; the validation error names the message field"
              }
            },
            {
              "index": 4,
              "fields": {
                "action": "Send a contact message of exactly 250 characters",
                "data": "message: 250 x 'x'",
                "expected result": "HTTP 201; the response echoes the submitted message and has status NEW"
              }
            },
            {
              "index": 5,
              "fields": {
                "action": "Send a contact message of 49 characters",
                "data": "message: 49 x 'x'",
                "expected result": "HTTP 422; the validation error names the message field"
              }
            }
          ]
        }
      }
    },
    {
      "key": "TC-2",
      "fields": {
        "issuetype": {
          "name": "Test"
        },
        "summary": "Verify that an authenticated customer's contact message is stored exactly as submitted",
        "description": "Read-back is only possible for the authenticated sender; anonymous callers cannot read messages.",
        "priority": {
          "name": "High"
        },
        "components": [
          {
            "name": "api"
          }
        ],
        "labels": [
          "AC-7"
        ],
        "issuelinks": [
          {
            "type": {
              "name": "Test",
              "inward": "is tested by",
              "outward": "tests"
            },
            "outwardIssue": {
              "key": "TOOL-1",
              "fields": {
                "summary": "Contact customer service from the storefront"
              }
            }
          },
          {
            "type": {
              "name": "Precondition",
              "inward": "is a precondition of",
              "outward": "has precondition"
            },
            "inwardIssue": {
              "key": "PRE-2",
              "fields": {
                "summary": "A customer account exists and a bearer token for it is available"
              }
            }
          }
        ],
        "customfield_10004": {
          "steps": [
            {
              "index": 1,
              "fields": {
                "action": "Send a contact message as the signed-in customer",
                "data": "{ \"subject\": \"customer-service\", \"message\": \"<valid 60 character message>\" }",
                "expected result": "HTTP 201; the response contains an id and status NEW"
              }
            },
            {
              "index": 2,
              "fields": {
                "action": "Read the stored message back by id as the same customer",
                "data": "GET /messages/{id}",
                "expected result": "HTTP 200; subject and message are identical to what was sent; status is NEW"
              }
            }
          ]
        }
      }
    },
