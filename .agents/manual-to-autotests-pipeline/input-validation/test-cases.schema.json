{
  "title": "Manual test cases (pipeline input)",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "ticket": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]+-\\d+$"
    },
    "testCases": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^TC-\\d+$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "level": {
            "type": "string",
            "enum": [
              "api",
              "ui"
            ]
          },
          "priority": {
            "type": "string",
            "enum": [
              "Critical",
              "High",
              "Medium",
              "Low"
            ]
          },
          "acRefs": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^AC-\\d+$"
            }
          },
          "preconditions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "steps": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "action": {
                  "type": "string",
                  "minLength": 1
                },
                "data": {
                  "type": "string",
                  "minLength": 1
                },
                "expected": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "action",
                "data",
                "expected"
              ],
              "additionalProperties": false
            }
          },
          "notes": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "title",
          "level",
          "priority",
          "acRefs",
          "preconditions",
          "steps",
          "notes"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "ticket",
    "testCases"
  ],
  "additionalProperties": false
}
