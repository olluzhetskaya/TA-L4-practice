    {
      "tcRef": "TC-2",
      "trigger": "POST /messages with a 120-character name",
      "method": "POST",
      "pathPattern": "/messages",
      "auth": "none",
      "requestFields": [
        "name",
        "email",
        "subject",
        "message"
      ],
      "responseFields": [
        "id",
        "name",
        "email",
        "subject",
        "message",
        "status",
        "created_at"
      ],
      "observed": [
        {
          "case": "name of 120 characters",
          "status": 500,
          "body": "{ message: 'Something went wrong' } — not a validation error"
        },
        {
          "case": "name of 100 characters",
          "status": 500,
          "body": "same server error: the real limit is lower than the declared 120"
        },
        {
          "case": "name of 50 characters",
          "status": 200,
          "body": "accepted; echoes the name, status NEW"
        }
      ]
    },
    {
      "tcRef": "TC-3",
      "trigger": "POST /messages with email / subject at and over their limits",
      "method": "POST",
      "pathPattern": "/messages",
      "auth": "none",
      "requestFields": [
        "name",
        "email",
        "subject",
        "message"
      ],
      "responseFields": [
        "id",
        "name",
        "email",
        "subject",
        "message",
        "status",
        "created_at"
      ],
      "observed": [
        {
          "case": "email of 257 characters",
          "status": 422,
          "body": "{ email: [string] }"
        },
        {
          "case": "email of 256 characters",
          "status": 200,
          "body": "accepted; echoes the email"
        },
        {
          "case": "subject of 121 characters",
          "status": 422,
          "body": "{ subject: [string] }"
        },
        {
          "case": "subject of 120 characters",
          "status": 200,
          "body": "accepted; echoes the subject"
        }
      ]
    }
  ],
  "findings": [
    {
      "tcRef": "TC-2",
      "step": 1,
      "expected": "A 120-character name is accepted and echoed",
      "observed": "HTTP 500 'Something went wrong' for names of 100 characters and above; 50 characters is accepted",
