{
  "meta": {
    "ticket": "TOOL-1",
    "date": "2026-11-11",
    "baseURL": "https://practicesoftwaretesting.com",
    "apiURL": "https://api.practicesoftwaretesting.com",
    "authFile": ".auth/customer.json"
  },
  "locators": [
    {
      "tcRef": "TC-3",
      "tcAction": "Fill in first name",
      "uiLabel": "First name",
      "locator": "getByLabel('First name')",
      "page": "contact",
      "verifiedBy": "fill",
      "notes": null
    },
    {
      "tcRef": "TC-3",
      "tcAction": "Fill in last name",
      "uiLabel": "Last name",
      "locator": "getByLabel('Last name')",
      "page": "contact",
      "verifiedBy": "fill",
      "notes": null
    },
    {
      "tcRef": "TC-3",
      "tcAction": "Fill in email address",
      "uiLabel": "Email address",
      "locator": "getByLabel('Email address')",
      "page": "contact",
      "verifiedBy": "fill",
      "notes": "Placeholder is 'Your email *'; the label is 'Email address'"
    },
    {
      "tcRef": "TC-3",
      "tcAction": "Choose a subject",
      "uiLabel": "Subject",
      "locator": "getByRole('combobox', { name: 'Subject' })",
      "page": "contact",
      "verifiedBy": "select",
      "notes": "Native select with no preselected option; options show labels (e.g. 'Customer service'), values are slugs (customer-service)"
    },
    {
      "tcRef": "TC-3",
      "tcAction": "Enter a message",
      "uiLabel": "Message *",
      "locator": "getByRole('textbox', { name: 'Message' })",
      "page": "contact",
      "verifiedBy": "fill",
      "notes": "Accessible name includes the asterisk; substring match is enough"
    },
    {
      "tcRef": "TC-3",
      "tcAction": "Send the form",
      "uiLabel": "Send",
      "locator": "getByRole('button', { name: 'Send' })",
      "page": "contact",
      "verifiedBy": "click",
      "notes": "First click after errors clear can miss because the error alerts collapse and shift the button; Playwright's actionability retry handles it"
    },
    {
      "tcRef": "TC-3",
      "tcAction": "The form is replaced by the confirmation",
      "uiLabel": "Thanks for your message! We will contact you shortly.",
      "locator": "getByRole('alert').filter({ hasText: 'Thanks for your message! We will contact you shortly.' })",
      "page": "contact",
      "verifiedBy": "assert",
      "notes": "Rendered in an element with role=alert; the form disappears"
    },
    {
      "tcRef": "TC-4",
      "tcAction": "A required error appears next to every field",
      "uiLabel": "First name is required",
      "locator": "getByRole('alert').filter({ hasText: 'First name is required' })",
      "page": "contact",
      "verifiedBy": "assert",
      "notes": "One role=alert per field; texts: First name / Last name / Email / Subject / Message + ' is required'. Email's error says 'Email', not 'Email address'"
    },
    {
      "tcRef": "TC-4",
      "tcAction": "The minimum-length error is shown",
      "uiLabel": "Message must be minimal 50 characters",
      "locator": "getByRole('alert').filter({ hasText: 'Message must be minimal 50 characters' })",
      "page": "contact",
      "verifiedBy": "assert",
      "notes": "Client-side rule; no request leaves the browser"
    }
  ],
  "apiCalls": [
    {
      "tcRef": "TC-1",
      "trigger": "Submit the contact form (anonymous)",
      "method": "POST",
      "pathPattern": "/messages",
      "auth": "none",
      "requestFields": [
        "name",
        "email",
        "subject",
        "message"
      ],
      "responseFields": [
        "id",
        "name",
        "email",
        "subject",
        "message",
        "status",
        "created_at"
      ],
      "observed": [
        {
          "case": "valid payload, 58-character message",
          "status": 200,
          "body": "echoes the payload + id, status NEW, created_at"
        },
        {
          "case": "email 'not-an-email'",
          "status": 422,
          "body": "{ email: [string] }"
        },
        {
          "case": "subject omitted",
          "status": 422,
          "body": "{ subject: [string] }"
        },
        {
          "case": "message of 251 characters",
          "status": 422,
          "body": "{ message: [string] }"
        },
        {
          "case": "message of 250 characters",
          "status": 200,
          "body": "echoes message, status NEW"
        },
        {
          "case": "message of 49 characters",
          "status": 200,
          "body": "accepted — the 50-character minimum is not enforced by the service"
        },
        {
          "case": "email omitted",
          "status": 200,
          "body": "accepted — email is not required by the service"
        },
        {
          "case": "subject 'bogus' (not in the form's list)",
          "status": 200,
          "body": "accepted — subject values are not validated"
        }
      ]
    },
    {
      "tcRef": "TC-2",
      "trigger": "Submit a message as the signed-in customer",
      "method": "POST",
      "pathPattern": "/messages",
      "auth": "bearer",
      "requestFields": [
        "subject",
        "message"
      ],
      "responseFields": [
        "id",
        "user_id",
        "subject",
        "message",
        "status",
        "created_at"
      ],
      "observed": [
        {
          "case": "subject + message with a customer bearer token",
          "status": 200,
          "body": "echoes subject/message, adds user_id, status NEW"
        }
      ]
    },
    {
      "tcRef": "TC-2",
      "trigger": "Read the stored message back by id",
      "method": "GET",
      "pathPattern": "/messages/{id}",
      "auth": "bearer",
      "requestFields": [],
      "responseFields": [
        "id",
        "user_id",
        "name",
        "email",
        "subject",
        "message",
        "status",
        "created_at",
        "user",
        "replies"
      ],
      "observed": [
        {
          "case": "GET by id as the sender",
          "status": 200,
          "body": "subject/message/status identical to what was sent; name and email are null for an authenticated sender"
        },
        {
          "case": "GET by id without a token",
          "status": 401,
          "body": "{ message: 'Unauthorized' }"
        }
      ]
    }
  ],
  "findings": [
    {
      "tcRef": "TC-1",
      "step": 4,
      "expected": "HTTP 201 for an accepted message",
      "observed": "HTTP 200 with the created record",
      "resolution": "assert-observed"
    },
    {
      "tcRef": "TC-1",
      "step": 5,
      "expected": "HTTP 422 naming the message field for a 49-character message",
      "observed": "HTTP 200 — the service accepts it; only the form enforces the 50-character minimum",
      "resolution": "move-to-ui"
    },
    {
      "tcRef": "TC-2",
      "step": 1,
      "expected": "HTTP 201 with an id and status NEW",
      "observed": "HTTP 200 with id, user_id and status NEW",
      "resolution": "assert-observed"
    },
    {
      "tcRef": "TC-4",
      "step": 1,
      "expected": "'<Field> is required' for email address",
      "observed": "The email error reads 'Email is required' while the label reads 'Email address'",
      "resolution": "assert-observed"
    }
  ]
}
