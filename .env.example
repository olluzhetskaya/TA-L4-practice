# Cursor CLI key — needed only for evals / agent runs (`agent --print`)
CURSOR_API_KEY=

# SUT: https://practicesoftwaretesting.com (Toolshop). Defaults are baked into playwright.config.ts.
TOOLSHOP_UI_URL=https://practicesoftwaretesting.com
TOOLSHOP_API_URL=https://api.practicesoftwaretesting.com

# Public demo account published by Toolshop — not a secret.
TOOLSHOP_CUSTOMER_EMAIL=customer@practicesoftwaretesting.com
TOOLSHOP_CUSTOMER_PASSWORD=welcome01

# Optional overrides
# Model for the rubric judge (npm run eval -- --judge); use one different from the model that wrote the specs.
# CURSOR_JUDGE_MODEL=
