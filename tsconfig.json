{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@fixtures": ["tests/fixtures/index.ts"],
      "@data/*": ["src/data/*"],
      "@pages/*": ["src/pages/*"],
      "@helpers/*": ["src/helpers/*"],
      "@config/*": ["src/config/*"],
      "@generated/*": ["src/types/generated/*"],
      "@src/*": ["src/*"]
    }
  },
  "include": [
    ".agents/**/*.ts",
    "src/**/*.ts",
    "tests/**/*.ts",
    "tools/**/*.ts",
    "scripts/**/*.ts",
    "playwright.config.ts"
  ],
  "exclude": ["node_modules", ".agents/manual-to-autotests-pipeline/eval/dataset/**", ".agents/manual-to-autotests-pipeline/eval/skeleton/**"]
}
